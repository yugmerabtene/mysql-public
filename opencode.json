{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 25000
    },
    "buffer": "25%"
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 25600
  },
  "watcher": {
    "ignore": [
      "books/**"
    ]
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 2,
    "background_compaction": true
  }
}
